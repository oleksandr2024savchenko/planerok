# Backend base URL (FastAPI). Leave empty to run on mock data.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to "false" to talk to the real API instead of mock data.
NEXT_PUBLIC_USE_MOCKS=true
# Telegram user ids (comma-separated) that get the pink theme. Everyone else sees purple.
NEXT_PUBLIC_PINK_USER_IDS=729424163
