BOT_TOKEN=123456:replace-me
# Public HTTPS URL of the Mini App (e.g. ngrok / Vercel). Telegram requires HTTPS.
WEBAPP_URL=https://example.com

DATABASE_URL=postgresql+asyncpg://planer:planer@localhost:5432/planer
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Google Gemini (google-genai) — voice + free-form text extraction.
# New AI Studio keys start with AQ. and need gemini-3.6-flash (or newer).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Google Calendar (OAuth refresh token OR a service-account JSON file).
# Scopes: https://www.googleapis.com/auth/calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional: domain-wide delegation subject for the service account.
GOOGLE_IMPERSONATE_EMAIL=
GOOGLE_CALENDAR_ID=primary
# Telegram user id that receives reminders for events imported from Google.
# GOOGLE_OWNER_USER_ID=
# Public HTTPS endpoint, e.g. https://api.example.com/webhooks/google-calendar
GOOGLE_WEBHOOK_URL=
GOOGLE_CHANNEL_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=

# Local development only: lets the API work without Telegram initData (browser outside Telegram).
# Leave unset in production. An empty value is not a valid user id.
# DEV_USER_ID=
