BOT_TOKEN=123456:replace-me
# Public HTTPS URL of the Mini App. Telegram requires HTTPS.
WEBAPP_URL=https://oleksandr2024savchenko.github.io/planerok/

DATABASE_URL=postgresql+asyncpg://planer:planer@localhost:5432/planer
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Google Gemini (google-genai) — voice + free-form text extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Google Calendar (OAuth refresh token OR a service-account JSON file).
# Scopes: https://www.googleapis.com/auth/calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional: domain-wide delegation subject for the service account.
GOOGLE_IMPERSONATE_EMAIL=
GOOGLE_CALENDAR_ID=primary
# Calendar of the second id in ALLOWED_TELEGRAM_IDS. Share it with the service account.
GOOGLE_PARTNER_CALENDAR_ID=
# Telegram user id that receives reminders for events imported from Google.
GOOGLE_OWNER_USER_ID=
# Public HTTPS endpoint, e.g. https://api.example.com/webhooks/google-calendar
GOOGLE_WEBHOOK_URL=
GOOGLE_CHANNEL_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=

# Local development only: lets the API work without Telegram initData (browser outside Telegram).
# Leave empty in production.
DEV_USER_ID=

# Comma-separated Telegram ids allowed to use the bot and the Mini App.
ALLOWED_TELEGRAM_IDS=

# «Додовбувач» for high-priority tasks (defaults shown; leave out to keep them).
# NAG_INTERVAL_MINUTES=5
# NAG_QUIET_START_HOUR=23
# NAG_QUIET_END_HOUR=8
# NAG_GIVE_UP_DAYS=3

# Gemini resilience: a backup model tried after the main one keeps failing, and a per-try timeout.
# GEMINI_FALLBACK_MODEL=
# GEMINI_TIMEOUT_SECONDS=60
